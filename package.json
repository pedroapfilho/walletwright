{
  "name": "walletwright-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "turbo run start",
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter demo test:e2e",
    "test:coverage": "turbo run test:coverage",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score",
    "fallow:audit": "fallow audit --base main",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "prepare": "husky",
    "check:shadcn": "node scripts/check-shadcn.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@shadcn/lint": "0.1.5",
    "fallow": "^3.27.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.69.0",
    "oxlint": "^1.84.0",
    "oxlint-config-awesomeness": "^4.5.1",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "oxlint-tsgolint": "^7.0.2002",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.2"
  },
  "lint-staged": {
    "!(*.d).{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint"
    ],
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1"
}
