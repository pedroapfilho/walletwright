{
  "name": "@walletwright/core",
  "version": "0.3.0",
  "description": "Playwright wallet automation for MetaMask, Phantom, Rabby, Solflare, and Slush across EVM, Solana, and Sui. Connect and sign in real browser extensions.",
  "keywords": [
    "e2e",
    "ethereum",
    "metamask",
    "phantom",
    "playwright",
    "rabby",
    "slush",
    "solana",
    "solflare",
    "sui",
    "testing",
    "wallet",
    "web3"
  ],
  "license": "MIT",
  "author": "Pedro Filho <pedro@filho.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroapfilho/walletwright.git",
    "directory": "packages/walletwright"
  },
  "bin": {
    "walletwright": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./chain": {
      "types": "./dist/chain.d.mts",
      "default": "./dist/chain.mjs"
    },
    "./mock": {
      "types": "./dist/mock.d.mts",
      "default": "./dist/mock.mjs"
    },
    "./mock-standard": {
      "types": "./dist/mock-standard.d.mts",
      "default": "./dist/mock-standard.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint src",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "classic-level": "^3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@repo/config-vitest": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^26.2.0",
    "prool": "^0.2.14",
    "typescript": "^7.0.2",
    "viem": "^2.55.11",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.48 <2",
    "prool": ">=0.2 <1",
    "viem": ">=2 <3"
  },
  "peerDependenciesMeta": {
    "prool": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  }
}
