# Copy to .env (gitignored) to point the landing page at a local docs app.
# The dev script resolves the portless URL itself, so set this only when running outside portless.
# Unset, docs links fall back to https://docs.walletwright.dev; keep it commented
# out rather than empty, since an empty value would override that fallback.
# NEXT_PUBLIC_DOCS_URL=https://walletwright.docs.localhost
