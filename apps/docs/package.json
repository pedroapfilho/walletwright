{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run --name walletwright.docs next dev --turbopack",
    "build": "next build",
    "start": "next start -p 4000",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "test:e2e": "playwright test",
    "lint": "oxlint app lib components proxy.ts next.config.ts source.config.ts mdx-components.tsx",
    "clean": "rm -rf .next .source node_modules"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "fumadocs-core": "^16.15.4",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-ui": "^16.15.4",
    "lucide-react": "^1.37.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@next/playwright": "16.3.3",
    "@playwright/test": "^1.62.1",
    "@repo/typescript-config": "workspace:*",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^7.0.2"
  }
}
