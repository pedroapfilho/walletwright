{
  "version": 1,
  "profile": "library",
  "mode": "affected",
  "test": {
    "setup": [
      {
        "name": "Read Playwright version",
        "id": "playwright",
        "run": "echo \"version=$(pnpm --filter @walletwright/core exec playwright --version | cut -d ' ' -f 2)\" >> \"$GITHUB_OUTPUT\""
      },
      {
        "name": "Restore Chromium",
        "uses": "actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0",
        "with": {
          "path": "~/.cache/ms-playwright",
          "key": "playwright-${{ runner.os }}-${{ runner.arch }}-${{ steps.playwright.outputs.version }}-chromium"
        }
      },
      {
        "name": "Install Chromium for the engine tests",
        "run": "pnpm --filter @walletwright/core exec playwright install --with-deps chromium"
      }
    ]
  }
}
